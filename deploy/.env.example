# Copy to /opt/open-model/shared/.env on the server. Never commit the real file.
MODEL_DOMAIN=model.example.com
ACME_EMAIL=ops@example.com
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MEMORY_LIMIT=20G
DEFAULT_MODEL=qwen3:4b

# Open-Secret integration for autonomous deployments.
# When OPEN_SECRET_URL is set, the deploy script fetches secrets from
# the Open-Secret endpoint and populates .env automatically.
# Set this to the Open-Secret machine identity endpoint URL.
OPEN_SECRET_URL=https://open-secret-production.up.railway.app

# Optional references for external control-plane integrations.
# Ollama does not consume Supabase credentials directly.
SUPABASE_URL=
