# Copy to /opt/open-model/shared/.env on the server. Never commit the real file.
MODEL_DOMAIN=model.example.com
ACME_EMAIL=ops@example.com
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MEMORY_LIMIT=20G
DEFAULT_MODEL=qwen3:4b

# Optional references for external control-plane integrations.
# Ollama does not consume Supabase or Open-Secret credentials directly.
SUPABASE_URL=
OPEN_SECRET_URL=
