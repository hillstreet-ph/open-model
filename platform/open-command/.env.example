# Open Command (SwarmClaw Fork) - Environment Configuration
# Connects to Ollama hub at localhost:11434

# Ollama Connection
OLLAMA_URL=http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434

# Server Configuration
WORKERS=4
PORT=5000
HOST=0.0.0.0
SWARM_MODE=true
MAX_AGENTS=20

# Agent Configuration
AGENT_TYPES=coder,debugger,planner,reviewer,researcher
CODER_MODEL=codellama
DEBUGGER_MODEL=codellama
PLANNER_MODEL=mistral
REVIEWER_MODEL=mistral
RESEARCHER_MODEL=llama3

# Task Execution
TASK_TIMEOUT=120s
MAX_TASKS_PER_AGENT=10
TASK_RETRY_COUNT=3
TASK_RETRY_DELAY=5s

# Cross-Platform Integration
CROSS_PLATFORM_BRIDGE_URL=http://localhost:8443
TASK_PIPELINE_URL=http://localhost:8444
ORCHESTRATOR_URL=http://localhost:8080
SWARM_COORDINATOR_URL=http://localhost:8445

# Open Connect Integration
OPEN_CONNECT_URL=http://localhost:3000
OPEN_CONNECT_API=http://localhost:8000

# Supabase Integration
SUPABASE_URL=https://olhtxibbyhucxcmhzblq.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_KEY=replace-with-service-key

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/open-command/agent.log

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
