# Open Worker (Hermes Agent Fork) - Environment Configuration
# Connects to Ollama hub at localhost:11434

# Ollama Connection
OLLAMA_URL=http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434

# Server Configuration
WORKERS=4
PORT=6000
HOST=0.0.0.0
WORKER_MODE=true
MAX_WORKERS=20

# Worker Configuration
WORKER_TYPES=executor,reviewer,formatter,validator,optimizer
EXECUTOR_MODEL=phi3
REVIEWER_MODEL=phi3
FORMATTER_MODEL=phi3
VALIDATOR_MODEL=phi3
OPTIMIZER_MODEL=llama3

# Task Processing
TASK_TIMEOUT=120s
MAX_TASKS_PER_WORKER=10
TASK_RETRY_COUNT=3
TASK_RETRY_DELAY=5s
WORKER_HEARTBEAT_INTERVAL=30s

# Cross-Platform Integration
CROSS_PLATFORM_BRIDGE_URL=http://localhost:8443
TASK_PIPELINE_URL=http://localhost:8444
ORCHESTRATOR_URL=http://localhost:8080
SWARM_COORDINATOR_URL=http://localhost:8445

# Open Connect Integration
OPEN_CONNECT_URL=http://localhost:3000

# Open Command Integration
OPEN_COMMAND_URL=http://localhost:5000

# Supabase Integration
SUPABASE_URL=https://olhtxibbyhucxcmhzblq.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_KEY=replace-with-service-key

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/open-worker/worker.log

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
