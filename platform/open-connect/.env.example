# Open Connect (Open Web UI Fork) - Environment Configuration
# Connects to Ollama hub at localhost:11434

# Ollama Connection
OLLAMA_URL=http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434

# Server Configuration
WORKERS=4
PORT=3000
HOST=0.0.0.0

# Authentication
WEBUI_SECRET_KEY=open-platform-key-change-in-production
SESSION_SECRET=change-me-in-production

# Model Configuration
DEFAULT_MODEL=llama3
FALLBACK_MODEL=mistral
MAX_MODELS=10

# API Bridge Configuration
API_BRIDGE_PORT=8000
API_BRIDGE_URL=http://localhost:8000

# Cross-Platform Integration
CROSS_PLATFORM_BRIDGE_URL=http://localhost:8443
TASK_PIPELINE_URL=http://localhost:8444
ORCHESTRATOR_URL=http://localhost:8080

# Supabase Integration
SUPABASE_URL=https://olhtxibbyhucxcmhzblq.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_KEY=replace-with-service-key

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/open-connect/access.log

# Health Check
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
